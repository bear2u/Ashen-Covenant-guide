---

import "@fontsource-variable/jetbrains-mono";
import "../styles/globals.css";
import "../styles/prose.css";
import { ClientRouter } from "astro:transitions";
import { config } from "virtual:nimbus/config";
import {
  withBase,
} from "@cloudflare/nimbus-docs/runtime";
import { SearchDialog } from "@/components/ui/search";

import type { BasePageProps } from "@cloudflare/nimbus-docs/types";

type Props = BasePageProps;

const {
  title,
  description,
  noindex,
  socialImage,
} = Astro.props;

const lang = config.locale ?? "en";
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <style is:inline set:html={`@font-face { font-family: "Noto Sans KR Variable"; src: url("${withBase("/fonts/NotoSansKR.ttf", baseUrl)}") format("truetype"); font-weight: 100 900; font-style: normal; font-display: swap; }`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline>
      (() => {
        const KEY = "ui-mode";
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        // A choice storage refused, kept until the page unloads.
        let unsaved = null;

        const readPref = () => {
          if (unsaved) return unsaved;
          try {
            const v = localStorage.getItem(KEY);
            return v === "dark" || v === "light" ? v : null;
          } catch {
            return null;
          }
        };

        const resolveMode = () => readPref() ?? "dark";

        const applyTheme = () => {
          const root = document.documentElement;
          const mode = resolveMode();
          if (mode === "dark") root.setAttribute("data-mode", "dark");
          else root.removeAttribute("data-mode");
          root.style.colorScheme = mode;
          document.querySelectorAll("[data-nb-theme-toggle]").forEach((b) => {
            b.setAttribute("data-nb-state", mode);
            b.setAttribute("aria-pressed", String(mode === "dark"));
          });
        };

        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
        media.addEventListener("change", () => {
          if (!readPref()) applyTheme();
        });
        window.addEventListener("storage", (e) => {
          if (e.key === KEY) applyTheme();
        });

        // The toggle passes a mode only when storage refused it.
        window.__nbApplyTheme = (mode) => {
          if (mode === "dark" || mode === "light") unsaved = mode;
          applyTheme();
        };
      })();
    </script>

    <title>{`${title} | ${config.title}`}</title>
    <meta name="description" content={description ?? config.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={withBase("/favicon.svg", baseUrl)} type="image/svg+xml" />
    <link rel="sitemap" href={withBase("/sitemap-index.xml", baseUrl)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={`${title} | ${config.title}`} />
    <meta property="og:description" content={description ?? config.description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={new URL(withBase(socialImage ?? "/og.png", baseUrl), Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-100 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground focus:no-underline focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2"
    >
      본문으로 건너뛰기
    </a>
    <slot />
    {config.search !== false && <SearchDialog />}

    <script>
      import { codeCopy, headingAnchors } from "@cloudflare/nimbus-docs/client";
      codeCopy();
      headingAnchors();
    </script>
  </body>
</html>
